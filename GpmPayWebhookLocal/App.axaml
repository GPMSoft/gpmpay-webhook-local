<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GpmPayWebhookLocal.App"
             Name="GPMPay Webhook Local"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Ô nhập -->
        <Style Selector="TextBox.field">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource BodyBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource MintBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- Ô chọn -->
        <Style Selector="ComboBox.field">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ComboBox.field ComboBoxItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ComboBox.field ComboBoxItem:selected">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Nhãn ô nhập -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Tiêu đề bảng trượt -->
        <Style Selector="TextBlock.sheet-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Bảng trượt -->
        <Style Selector="Border.sheet">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BoxShadow" Value="{StaticResource SheetShadow}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Hàng thông tin trong mục Trạng thái -->
        <Style Selector="Border.kv">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,11" />
        </Style>

        <Style Selector="TextBlock.num">
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
    </Application.Styles>
</Application>
